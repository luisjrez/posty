{
  "name": "posty",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-unistyles": "^3.5.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@expo/env": "^2.4.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "app-icon-badge": "^0.1.2",
    "eas-build-cache-provider": "^24.8.0",
    "eslint": "^9",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "lint-staged": "^17.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "env:use": "bun scripts/env/use.ts",
    "start": "bun run env:use development && expo start",
    "ios": "bun run env:use development && expo run:ios",
    "android": "bun run env:use development && expo run:android",
    "ios:stage": "bun run env:use staging && expo prebuild --clean --platform ios && expo run:ios",
    "android:stage": "bun run env:use staging && expo prebuild --clean --platform android && expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e:ios": "maestro test .maestro -e APP_ID=com.luisjuarez.posty.stage",
    "e2e:android": "maestro test .maestro -e APP_ID=com.luisjuarez.posty.stage",
    "check": "bun run ds:check && bun run typecheck && bun run lint && bun run test",
    "prepare": "husky",
    "ds:apply": "bun scripts/design-system/cli.ts",
    "ds:check": "bun scripts/design-system/cli.ts --check",
    "icons:generate": "bun scripts/icons/generate.ts",
    "eas-build-post-install": "bun run ds:apply --ds=${DESIGN_SYSTEM:-posty}"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.scratch/"
    ],
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "require",
        "default"
      ]
    },
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|until-async)|.*\\.mjs$)"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "private": true
}
